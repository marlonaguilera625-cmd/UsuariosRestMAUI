<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UsuariosRestMAUI.ViewModels"
             xmlns:model="clr-namespace:UsuariosRestMAUI.Models"
             x:Class="UsuariosRestMAUI.Views.CrearUsuarioPage"
             x:DataType="vm:CrearUsuarioViewModel"
             Title="Nuevo usuario" BackgroundColor="{StaticResource FondoDirectorio}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="14" MaximumWidthRequest="640" HorizontalOptions="Fill">
            <Label Style="{StaticResource TituloDirectorio}" Text="Crear usuario" />
            <Label Text="JSONPlaceholder simula el envío y devuelve un ID de ejemplo."
                   HorizontalTextAlignment="Center" Style="{StaticResource DatoDirectorio}" />
            <Border Style="{StaticResource TarjetaDirectorio}">
                <VerticalStackLayout Spacing="7" IsEnabled="{Binding PuedeInteractuar}">
                    <Label Text="Nombre" Style="{StaticResource DatoDirectorio}" />
                    <Entry Text="{Binding Nombre}" Keyboard="Text" Placeholder="Nombre completo" SemanticProperties.Description="Nombre" />
                    <Label Text="Correo electrónico" Style="{StaticResource DatoDirectorio}" />
                    <Entry Text="{Binding Correo}" Keyboard="Email" Placeholder="nombre@ejemplo.com" SemanticProperties.Description="Correo electrónico" />
                    <Label Text="Teléfono" Style="{StaticResource DatoDirectorio}" />
                    <Entry Text="{Binding Telefono}" Keyboard="Telephone" Placeholder="+504 0000-0000" SemanticProperties.Description="Teléfono" />
                    <Label Text="Sitio web" Style="{StaticResource DatoDirectorio}" />
                    <Entry Text="{Binding SitioWeb}" Keyboard="Url" Placeholder="https://ejemplo.com" SemanticProperties.Description="Sitio web" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource AcentoDirectorio}" HorizontalOptions="Center"
                                       SemanticProperties.Description="Solicitud en curso" />
                    <Label Style="{StaticResource ErrorDirectorio}" Text="{Binding Error}" IsVisible="{Binding HayError}" />
                    <Label Style="{StaticResource NombreDirectorio}" IsVisible="{Binding HayResultado}"
                           Text="{Binding Resultado.Id, StringFormat='Envío simulado · ID devuelto por la API: {0}'}" />
                    <Button Text="Enviar usuario" Command="{Binding EnviarCommand}" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
